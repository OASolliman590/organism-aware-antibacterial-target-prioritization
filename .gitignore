__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/
.DS_Store
.env

# Unpublished research inputs and compound-specific generated outputs.
# These remain available locally but are not committed to GitHub.
inputs/*
!inputs/.gitkeep
data/compounds/*
!data/compounds/.gitkeep
results/*
!results/.gitkeep

# Large raw CARD release archives and extracted source files.
# Regenerate them with pipeline/fetch_card_data.py when needed.
data/card/*.tar.bz2
data/card/data/*
data/card/ontology/*
!data/card/.gitkeep

# Temporary logs and benchmark cache files.
*.log

# Development-only diagnostics.
pipeline/probe_*.py
